<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>inRiverCommunity.Rest.Client</PackageId>
    <Version>1.0.3</Version>
    <Authors>Robert Bialy</Authors>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Client for inRiver Rest API</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/robert-bialy/inriver-rest-client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/robert-bialy/inriver-rest-client</RepositoryUrl>
    <AssemblyVersion>0.1.0.3</AssemblyVersion>
    <FileVersion>0.1.0.3</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="RestSharp" Version="107.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RestSharp, Version=106.12.0.0, Culture=neutral, PublicKeyToken=598062e77f915f75">
      <HintPath>..\packages\RestSharp.106.12.0\lib\netstandard2.0\RestSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
</Project>