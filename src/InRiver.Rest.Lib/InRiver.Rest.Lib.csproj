<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>inRiverCommunity.Rest.Client</PackageId>
    <Version>2.0.0</Version>
    <Authors>Robert Bialy</Authors>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Client for inRiver Rest API</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/robert-bialy/inriver-rest-client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/robert-bialy/inriver-rest-client</RepositoryUrl>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
